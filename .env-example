# ============================================================
# Cấu hình cho translate.py
# ============================================================
# Sao chép file này và đặt tên .env, KHÔNG commit lên Git!

# --- Gemini API ---
GEMINI_API_KEY=[GCP_API_KEY]

# --- Model Gemini (mặc định: gemini-2.0-flash) ---
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Batch & rate-limit ---
# Số segment gửi mỗi lần gọi API
TRANSLATE_BATCH_SIZE=20
# Chờ giữa các batch (giây) — tránh rate limit free tier
TRANSLATE_DELAY=1.5

# --- PaddleOCR ---
# ROI: chỉ nhận diện từ % chiều cao này trở xuống (0.55 = 55% từ trên)
OCR_ROI_TOP=0.55
# Độ rộng ảnh khi detect (pixels)
OCR_DET_WIDTH=960
# Device: cpu | gpu:0 | auto (để trống = auto)
OCR_DEVICE=gpu

# --- Render video ---
# CRF chất lượng libx264 (18 = rất cao, 23 = mặc định ffmpeg)
RENDER_CRF=18
# Preset libx264: ultrafast | veryfast | fast | medium
RENDER_PRESET=medium
# Bật NVENC GPU encoding (true/false)
RENDER_NVENC=true
